# NFPD Appeals Bot - self-hosted .env template
#
# Copy to `.env` alongside docker-compose.yml. Never commit the real .env.

# ── Required ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=

# The appeals-postgres container is on the nodey-monitoring network. Hostname
# is the container name; port 5432 inside the network.
DATABASE_URL=postgresql://appeals:CHANGE_ME@appeals-postgres:5432/appeals

# ── Guild allowlist ─────────────────────────────────────────────────────────
APPROVED_GUILD_IDS=
LEAVE_UNAPPROVED_GUILDS=true
DEVELOPER_IDS=1285998518213017663

# ── Appeal / voting ─────────────────────────────────────────────────────────
MINIMUM_VOTES=3
VOTING_HOURS=48
BAN_TEAM_ROLE_IDS=
STAFF_ROLE_IDS=
APPEAL_COOLDOWN_HOURS=0

# ── Runtime ─────────────────────────────────────────────────────────────────
DB_CONNECT_MAX_WAIT=120
DB_POOL_MIN=1
DB_POOL_MAX=5
LOG_LEVEL=INFO

# Optional: container memory limit (used by docker-compose.yml).
# BOT_MEM_LIMIT=256m
