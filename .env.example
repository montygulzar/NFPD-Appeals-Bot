# NFPD Appeals Bot - self-hosted .env template
#
# Copy to `.env` alongside docker-compose.yml. Never commit the real .env.

# ── Required ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=

# The appeals-postgres container is on the nodey-monitoring network. Hostname
# is the container name; port 5432 inside the network.
DATABASE_URL=postgresql://appeals:CHANGE_ME@appeals-postgres:5432/appeals

# ── Guild allowlist ─────────────────────────────────────────────────────────
APPROVED_GUILD_IDS=
LEAVE_UNAPPROVED_GUILDS=true
DEVELOPER_IDS=1285998518213017663

# ── Appeal / voting ─────────────────────────────────────────────────────────
MINIMUM_VOTES=3
VOTING_HOURS=48
BAN_TEAM_ROLE_IDS=
STAFF_ROLE_IDS=
APPEAL_COOLDOWN_HOURS=0

# ── Runtime ─────────────────────────────────────────────────────────────────
DB_CONNECT_MAX_WAIT=120
DB_POOL_MIN=1
DB_POOL_MAX=5
LOG_LEVEL=INFO

# ── Mod Bot integration (Execute Unban) ─────────────────────────────────────
# Execute Unban asks the NFPD Mod Bot to unban the user in the MAIN server
# (bans live there, not in the appeals server). Both bots are on the
# nodey-monitoring network. INTERNAL_API_TOKEN must be the same long random
# value in BOTH bots' .env files (e.g. `openssl rand -hex 32`).
MODBOT_API_URL=http://nfpd-mod-bot:8080
INTERNAL_API_TOKEN=
MAIN_GUILD_ID=
MODBOT_TIMEOUT_SECONDS=15

# Health server (/health, /ready) - internal only, not published.
HEALTH_PORT=8080

# Optional: container memory limit (used by docker-compose.yml).
# BOT_MEM_LIMIT=256m
